# ---------------------------------------------------------------------------
# Variables de entorno de la API de Gestión de Ferreteria
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Los secretos se generan con:
#
#   openssl rand -base64 48                     # para APP_KEY
#   php artisan key:generate --show
#
# Las variables `FERRETERIA_*` son opcionales: si no se definen, se usan los
# valores por omisión de `config/ferreteria.php`.
# ---------------------------------------------------------------------------

APP_NAME="Ferretería Hefesto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# El rol de esta conexión NO puede ser superusuario ni tener BYPASSRLS.
# Con cualquiera de las dos, PostgreSQL ignora las políticas de Row Level
# Security y una ferreteria podria ver los datos de otra. Lo comprueba:
#   php artisan ferreteria:verificar-aislamiento
DB_CONNECTION=pgsql
DB_DATABASE=ferreteria
DB_USERNAME=ferreteria_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=ferreteria_admin
DB_ADMIN_PASSWORD=

DB_HOST=postgres
DB_PORT=5432

# Solo en producción: Redis exige contrasena.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/ferreteria/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/acceso/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_GRUPO_ADMIN=ferreteria-administradores
AUTHENTIK_GRUPO_OPERADORES=ferreteria-operadores

# ---------------------------------------------------------------------------
# Reglas de la ferreteria (opcionales)
# ---------------------------------------------------------------------------
# Decimales con que se guardan las cantidades. Tres es lo habitual en
# materiales de construccion (por ejemplo, 12,5 kg de cemento). No es un
# detalle menor: con dos decimales, media bolsa de arena no se puede registrar.
FERRETERIA_DECIMALES_CANTIDAD=3

# Cuantos decimales se muestran al convertir una cantidad entre unidades.
FERRETERIA_DECIMALES_CONVERSION=4

# Tolerancia de diferencia en el arqueo de caja, en la moneda del corte.
# Passa del valor teorico: con cero, cualquier error de cambio se reporta
# como diferencia, que es justo lo que el dueño quiere ver.
FERRETERIA_TOLERANCIA_CAJA=0

# Máximo de renglones que acepta una venta de mostrador. Es una protección
# de la pantalla, no una regla del negocio: una venta con cuatrocientos
# renglones en un mostrador es una transferencia mal digitada.
FERRETERIA_RENGOLONES_MAXIMOS=200

# Cantidad de decimales con que se redondea el total de una venta antes de
# cobrarla. El redondeo se hace UNA vez, al final, y queda escrito en la venta.
FERRETERIA_DECIMALES_TOTAL_VENTA=2

# Envío de avisos de reposición. En false el aviso se genera y se ve en
# pantalla, pero no sale a internet: no hay canal de correo configurado.
FERRETERIA_ALERTAS_ENVIO_ACTIVO=false